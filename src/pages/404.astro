---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { SITE } from '../consts';
---

<BaseLayout title={`Page not found — ${SITE.name}`} noindex>
  <section class="flex min-h-[70vh] items-center">
    <div class="mx-auto w-full max-w-3xl px-6 py-24 lg:px-8">
      <p class="eyebrow">404</p>
      <h1 class="mt-5 text-4xl leading-[1.1] sm:text-5xl">This page drifted off.</h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-muted">
        The link is broken or the page has moved. The 2008&ndash;2014 version of this site
        lives in the repository history now, tagged for posterity.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href="/" withArrow>Back home</Button>
        <Button href="/about" variant="ghost">About Felipe</Button>
      </div>
    </div>
  </section>
</BaseLayout>
