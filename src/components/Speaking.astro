---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { ENGAGEMENTS } from '../content/site-content';
import speakingPhoto from '../assets/felipe-plets-speaking.jpg';
---

<Section
  id="speaking"
  eyebrow="Speaking & work"
  title="Ways we can work together"
  lead="Most of my engagements start with the same conversation: the team is using AI, output is up, and nobody is quite sure whether that is good news yet."
>
  <div class="mt-16 grid gap-10 sm:grid-cols-3 sm:gap-8">
    {
      ENGAGEMENTS.map((item) => (
        <article class="flex flex-col" data-reveal>
          <div class="h-px w-12 bg-copper"></div>
          <h3 class="mt-6 text-xl leading-snug">{item.title}</h3>
          <p class="mt-3 text-[0.975rem] leading-relaxed text-muted">{item.description}</p>
        </article>
      ))
    }
  </div>

  <figure
    class="relative mt-16 overflow-hidden rounded-2xl border border-line"
    data-reveal
  >
    <Image
      src={speakingPhoto}
      alt="Felipe Plets speaking during a radio interview"
      widths={[720, 1080, 1440]}
      sizes="(min-width: 1024px) 64rem, 92vw"
      class="aspect-[21/9] w-full object-cover object-center contrast-[1.02] saturate-[0.9]"
      loading="lazy"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-ink/10 to-transparent"
    >
    </div>
    <div class="pointer-events-none absolute inset-0 bg-copper/20 mix-blend-soft-light"></div>
  </figure>
</Section>
